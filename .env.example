# Copy to .env, then replace every change-me value before production launch.
X1_ENV=development
X1_HOST=0.0.0.0
X1_PORT=8000
X1_BIND_ADDRESS=127.0.0.1
# Installer replaces this with the absolute host path used by the sandbox worker.
X1_HOST_DATA_ROOT=/absolute/path/to/OLYA-AI/data

# Bound HTTP admission before requests reach Python/inference queues.
X1_HTTP_LIMIT_CONCURRENCY=128
X1_HTTP_BACKLOG=2048
X1_HTTP_KEEPALIVE_SECONDS=5

POSTGRES_PASSWORD=change-me-db
X1_DATABASE_URL=postgresql+psycopg://x1:change-me-db@db:5432/x1
# Fail fast instead of tying up all request threads when PostgreSQL is saturated.
X1_DATABASE_POOL_SIZE=8
X1_DATABASE_MAX_OVERFLOW=4
X1_DATABASE_POOL_TIMEOUT_SECONDS=5
X1_DATABASE_POOL_RECYCLE_SECONDS=1800

X1_LLAMA_BASE_URL=http://llama:8080
X1_LLAMA_MODEL_NAME=Qwen3-30B-A3B-Q4_K_M
X1_MAX_CONTEXT_TOKENS=8192
X1_DEEP_CONTEXT_TOKENS=8192
X1_LLAMA_THREADS=8
X1_LLAMA_THREADS_BATCH=8
X1_LLAMA_MEMORY_LIMIT=24g
X1_MAX_CONCURRENT_GENERATIONS=1
X1_MAX_QUEUE_SIZE=64
X1_INFERENCE_QUEUE_TIMEOUT_SECONDS=120
X1_DEFAULT_MAX_OUTPUT_TOKENS=1200
X1_REQUEST_TIMEOUT_SECONDS=180

X1_ADMIN_BOOTSTRAP_TOKEN=change-me
X1_SESSION_TTL_DAYS=30
X1_DATABASE_AUTO_CREATE_SCHEMA=false
X1_DEFAULT_MONTHLY_COMPUTE_SECONDS=600
X1_DEFAULT_MAX_CONCURRENT_INFERENCE=1
X1_DEFAULT_MAX_CONCURRENT_JOBS=1
X1_JOB_LEASE_SECONDS=120
X1_JOB_POLL_SECONDS=1.0

X1_FILE_STORAGE_PATH=./data/files
# Untrusted PDF/DOCX parsing runs in a killable child process, not the API loop.
X1_FILE_PARSE_TIMEOUT_SECONDS=45
X1_FILE_PARSE_MEMORY_MB=768
X1_FILE_MAX_EXTRACTED_CHARS=2000000
X1_DOCUMENT_STORAGE_PATH=./data/documents
X1_DOCUMENT_RENDER_TIMEOUT_SECONDS=60
X1_DOCUMENT_MAX_PAGES=300
# LibreOffice/pdftoppm are intentionally serialized on the low-cost node.
X1_DOCUMENT_MAX_CONCURRENT_RENDERS=1
X1_DOCUMENT_RENDER_QUEUE_TIMEOUT_SECONDS=5
X1_CODE_WORKSPACE_STORAGE_PATH=./data/code_workspaces
X1_PROJECT_RUNTIME_STORAGE_PATH=./data/project_runtimes
X1_IMAGE_STORAGE_PATH=./data/images
X1_BACKUP_STORAGE_PATH=./backups

X1_RESEARCH_TIMEOUT_SECONDS=15
X1_RESEARCH_MAX_BYTES=2000000
X1_RESEARCH_MAX_CHARS=500000
X1_RESEARCH_MAX_REDIRECTS=3
X1_SEARCH_PROVIDER=searxng
X1_SEARCH_PROVIDERS=searxng
X1_SEARXNG_BASE_URL=http://searxng:8080
X1_BRAVE_SEARCH_API_KEY=
X1_SEARCH_TIMEOUT_SECONDS=10
X1_SEARCH_CACHE_TTL_SECONDS=3600
X1_RESEARCH_MAX_SEARCH_QUERIES=6
X1_RESEARCH_MAX_DISCOVERY_RESULTS=30

X1_CODE_WORKSPACE_MAX_ARCHIVE_BYTES=26214400
X1_CODE_WORKSPACE_MAX_UNPACKED_BYTES=104857600
X1_CODE_WORKSPACE_MAX_FILES=5000
X1_CODE_ALLOW_UNSAFE_COMMANDS=false

X1_IMAGE_BACKEND=disabled
X1_IMAGE_MODEL_NAME=
X1_IMAGE_MODEL_PATH=
X1_IMAGE_MAX_DIMENSION=1536
X1_IMAGE_MAX_PIXELS=2359296
X1_IMAGE_MAX_STEPS=50
X1_IMAGE_DEFAULT_STEPS=24
X1_IMAGE_MAX_ACTIVE_PER_USER=1
X1_IMAGE_WORKER_IDLE_EXIT_SECONDS=30
X1_IMAGE_QA_MAX_REPAIRS=1
X1_IMAGE_PERCEPTUAL_ERROR_MAX=4.0
X1_IMAGE_PREVIEW_MAX_SIDE=512
X1_IMAGE_STORAGE_MIN_FREE_BYTES=2147483648
X1_IMAGE_STORAGE_MIN_FREE_PERCENT=10
X1_IMAGE_USER_STORAGE_QUOTA_BYTES=2147483648
X1_IMAGE_REJECTED_RETENTION_DAYS=7

X1_PROJECT_RUNTIME_SECRET_KEY=change-me-runtime-secret
X1_PROJECT_RUNTIME_DEFAULT_CPU_LIMIT=1.0
X1_PROJECT_RUNTIME_DEFAULT_MEMORY_MB=1024
X1_PROJECT_RUNTIME_DEFAULT_DISK_MB=2048
X1_PROJECT_RUNTIME_DEFAULT_PROCESS_LIMIT=64
# Hard host envelope: both app and sandbox-worker independently enforce it.
X1_PROJECT_RUNTIME_MAX_CPU_LIMIT=1.0
X1_PROJECT_RUNTIME_MAX_MEMORY_MB=2048
X1_PROJECT_RUNTIME_MAX_PROCESS_LIMIT=128
X1_PROJECT_SANDBOX_BACKEND=remote
X1_PROJECT_SANDBOX_IMAGE=x1-sandbox:0.39
X1_PROJECT_SANDBOX_WORKER_URL=http://sandbox-worker:8090
X1_PROJECT_SANDBOX_WORKER_TOKEN=change-me-sandbox-worker
X1_PROJECT_SANDBOX_COMMAND_TIMEOUT_SECONDS=300
X1_PROJECT_SANDBOX_PREVIEW_TIMEOUT_SECONDS=120
X1_SANDBOX_MAX_CONCURRENT_EXECUTIONS=1
X1_SANDBOX_MAX_ACTIVE_PREVIEWS=1
X1_SANDBOX_MAX_MEMORY_MB=2048
X1_SANDBOX_MAX_CPU=1.0
X1_SANDBOX_MAX_PIDS=128
X1_SANDBOX_PREVIEW_TTL_SECONDS=900

X1_COMMERCE_CPU_MICROUNITS_PER_SECOND=1000
X1_COMMERCE_GPU_MICROUNITS_PER_SECOND=10000
X1_COMMERCE_IMAGE_WORKER_MICROUNITS_PER_SECOND=5000
X1_COMMERCE_SANDBOX_MICROUNITS_PER_SECOND=2000
X1_PAYMENT_INGEST_SECRET=
X1_API_DEFAULT_RATE_LIMIT_PER_MINUTE=60
X1_API_MAX_RATE_LIMIT_PER_MINUTE=600

X1_MONTHLY_SERVER_COST_RUB=4000
X1_CHAT_HISTORY_MESSAGES=48
X1_CHAT_MESSAGE_PAGE_SIZE=100
X1_HEALTH_CHECKPOINT_STALE_SECONDS=300
X1_HEALTH_BACKUP_MAX_AGE_HOURS=36
X1_RELEASE_GATE_REPORT_PATH=./backups/release-gate-latest.json
X1_RESTORE_DRILL_REPORT_PATH=./backups/restore-drill-latest.json
X1_RELEASE_GATE_MAX_AGE_HOURS=24
X1_RESTORE_DRILL_MAX_AGE_HOURS=168

X1_CAPACITY_REPORT_PATH=./backups/capacity-latest.json
X1_CAPACITY_REPORT_MAX_AGE_HOURS=168
X1_CAPACITY_COMPUTE_HEADROOM_RATIO=1.25
X1_CAPACITY_MIN_MONTHLY_COMPUTE_SECONDS=300
X1_CAPACITY_MAX_MONTHLY_COMPUTE_SECONDS=14400
X1_BETA_MIN_PARTICIPANTS=50
X1_BETA_MAX_PARTICIPANTS=100
X1_BETA_MIN_TASKS=500
X1_BETA_MIN_REQUEST_SUCCESS_RATE=0.97
X1_BETA_MAX_FRUSTRATION_PER_REQUEST=0.05
X1_BETA_MAX_P95_QUEUE_MS=5000

X1_BETA_WAVE_DEFAULT_SIZE=10
X1_BETA_WAVE_MIN_OBSERVATION_REQUESTS=50
X1_BETA_WAVE_MAX_QUEUE_REGRESSION_RATIO=1.50
X1_BETA_WAVE_MAX_DURATION_REGRESSION_RATIO=1.50
X1_BETA_WAVE_MIN_CPU_EFFICIENCY_RATIO=0.70
X1_BETA_TREND_MAX_SUCCESS_DROP=0.02
X1_BETA_TREND_MAX_FRUSTRATION_INCREASE=0.02
X1_BETA_TREND_MAX_QUALITY_DROP=0.05
X1_BETA_OPERATIONS_SCHEDULER_ENABLED=true
X1_BETA_OPERATIONS_COHORT=closed-beta-1
X1_BETA_OPERATIONS_WINDOW_DAYS=30
X1_BETA_OPERATIONS_CHECK_INTERVAL_SECONDS=3600
X1_BETA_SNAPSHOT_INTERVAL_HOURS=24

# Production fail-closed default: registration/login remain public, but expensive
# AI/research/development routes require beta membership or rollout eligibility.
X1_PUBLIC_LAUNCH_ENFORCE_EXPOSURE=true
X1_PUBLIC_LAUNCH_WATCHDOG_ENABLED=true
X1_PUBLIC_LAUNCH_WATCHDOG_INTERVAL_SECONDS=300
X1_PUBLIC_LAUNCH_AUTO_ROLLBACK=true
X1_PUBLIC_LAUNCH_BREAKER_MIN_REQUESTS=50
X1_PUBLIC_LAUNCH_CANARY_MIN_REQUESTS=30
X1_PUBLIC_LAUNCH_MAX_FAILURE_RATE=0.03
X1_PUBLIC_LAUNCH_MAX_REQUESTS_PER_USER_HOUR=120
X1_PUBLIC_LAUNCH_GLOBAL_BUDGET_MICROUNITS=0

X1_PLAN_RATIO_FREE=0.25
X1_PLAN_RATIO_X1=1.0
X1_PLAN_RATIO_PRO=2.0
X1_PLAN_RATIO_MAX=4.0
X1_PLAN_RATIO_BUSINESS=8.0
X1_PLAN_SHARE_FAST=0.20
X1_PLAN_SHARE_WORK=0.35
X1_PLAN_SHARE_DEEP=0.25
X1_PLAN_SHARE_API=0.10
X1_PLAN_SHARE_IMAGE=0.05
X1_PLAN_SHARE_SANDBOX=0.05
