# Starter-safe defaults for OLYA AI. Copy to .env; the starter installer fills
# secrets automatically. Do not expose port 8000 directly to the Internet.
X1_ENV=development
X1_SERVER_OPTIMIZATION_PROFILE=starter_6gb
X1_HOST=0.0.0.0
X1_PORT=8000
X1_BIND_ADDRESS=127.0.0.1
X1_HOST_DATA_ROOT=/absolute/path/to/OLYA-AI/data

# HTTP admission: keep request tasks bounded before DB/inference allocation.
X1_HTTP_LIMIT_CONCURRENCY=32
X1_HTTP_BACKLOG=512
X1_HTTP_KEEPALIVE_SECONDS=5

POSTGRES_PASSWORD=change-me-db
X1_DATABASE_URL=postgresql+psycopg://x1:change-me-db@db:5432/x1
X1_DATABASE_POOL_SIZE=3
X1_DATABASE_MAX_OVERFLOW=1
X1_DATABASE_POOL_TIMEOUT_SECONDS=5
X1_DATABASE_POOL_RECYCLE_SECONDS=1800
X1_DATABASE_CONNECT_TIMEOUT_SECONDS=5
X1_DATABASE_STATEMENT_TIMEOUT_MS=30000
X1_DATABASE_LOCK_TIMEOUT_MS=10000
X1_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
X1_DB_MEMORY_LIMIT_MB=384
X1_SEARX_MEMORY_LIMIT_MB=256
X1_APP_MEMORY_LIMIT_MB=768

# 6 GiB production starter: official Qwen3-4B Q4_K_M, one decode at a time.
X1_LLAMA_BASE_URL=http://llama:8080
X1_LLAMA_MODEL_NAME=Qwen3-4B-Q4_K_M
X1_LLAMA_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf
X1_MAX_CONTEXT_TOKENS=4096
X1_DEEP_CONTEXT_TOKENS=4096
X1_LLAMA_THREADS=3
X1_LLAMA_THREADS_BATCH=3
X1_LLAMA_MEMORY_LIMIT=3200m
X1_MAX_CONCURRENT_GENERATIONS=1
X1_MAX_QUEUE_SIZE=16
X1_INFERENCE_MAX_QUEUED_PER_PRINCIPAL=1
X1_INFERENCE_QUEUE_TIMEOUT_SECONDS=90
X1_DEFAULT_MAX_OUTPUT_TOKENS=768
X1_REQUEST_TIMEOUT_SECONDS=150

X1_OVERLOAD_CHAT_MAX_ACTIVE_HTTP=2
X1_OVERLOAD_CHAT_MAX_QUEUE=12
X1_OVERLOAD_CHAT_QUEUE_TIMEOUT_SECONDS=75
X1_OVERLOAD_RESEARCH_MAX_ACTIVE_HTTP=2
X1_OVERLOAD_RESEARCH_MAX_QUEUE=8
X1_OVERLOAD_RESEARCH_QUEUE_TIMEOUT_SECONDS=12
X1_OVERLOAD_IMAGE_MAX_ACTIVE_HTTP=1
X1_OVERLOAD_IMAGE_MAX_QUEUE=2
X1_OVERLOAD_IMAGE_QUEUE_TIMEOUT_SECONDS=8
X1_OVERLOAD_SANDBOX_MAX_ACTIVE_HTTP=1
X1_OVERLOAD_SANDBOX_MAX_QUEUE=2
X1_OVERLOAD_SANDBOX_QUEUE_TIMEOUT_SECONDS=10
X1_OVERLOAD_MAX_QUEUED_PER_PRINCIPAL=1
X1_OVERLOAD_BREAKER_FAILURES=4
X1_OVERLOAD_BREAKER_COOLDOWN_SECONDS=20

X1_ADMIN_BOOTSTRAP_TOKEN=change-me
X1_SESSION_TTL_DAYS=30
X1_SESSION_MAX_ACTIVE_PER_USER=20
X1_DATABASE_AUTO_CREATE_SCHEMA=false
X1_DEFAULT_MONTHLY_COMPUTE_SECONDS=600
X1_DEFAULT_MAX_CONCURRENT_INFERENCE=1
X1_DEFAULT_MAX_CONCURRENT_JOBS=1
X1_JOB_LEASE_SECONDS=120
X1_JOB_POLL_SECONDS=1.0

# Storage is deliberately conservative on an 80 GB disk.
X1_FILE_STORAGE_PATH=./data/files
X1_MAX_FILE_SIZE_BYTES=10485760
X1_FILE_CHUNK_CHARS=1400
X1_FILE_CHUNK_OVERLAP_CHARS=140
X1_FILE_CONTEXT_CHUNKS=4
X1_MAX_PDF_PAGES=200
X1_MAX_DOCX_UNPACKED_BYTES=52428800
X1_FILE_PARSE_TIMEOUT_SECONDS=35
X1_FILE_PARSE_MEMORY_MB=384
X1_FILE_MAX_EXTRACTED_CHARS=1000000
X1_FILE_USER_STORAGE_QUOTA_BYTES=536870912
X1_FILE_STORAGE_MIN_FREE_BYTES=10737418240
X1_FILE_STORAGE_MIN_FREE_PERCENT=15

# Heavy document rendering is disabled in starter_6gb. Enable a remote worker
# after upgrading RAM; structural DOCX handling remains in the application.
X1_DOCUMENT_STORAGE_PATH=./data/documents
X1_DOCUMENT_RENDER_BACKEND=disabled
X1_DOCUMENT_RENDER_WORKER_URL=http://document-worker:8091
X1_DOCUMENT_RENDER_WORKER_TOKEN=change-me-document-worker
X1_DOCUMENT_RENDER_TIMEOUT_SECONDS=60
X1_DOCUMENT_MAX_PAGES=120
X1_DOCUMENT_RASTER_DPI=96
X1_DOCUMENT_QA_MAX_REPAIRS=1
X1_DOCUMENT_MAX_CONCURRENT_RENDERS=1
X1_DOCUMENT_RENDER_QUEUE_TIMEOUT_SECONDS=5

# Self-hosted web research stays available, but with a small bounded envelope.
X1_RESEARCH_TIMEOUT_SECONDS=12
X1_RESEARCH_MAX_BYTES=1000000
X1_RESEARCH_MAX_CHARS=250000
X1_RESEARCH_MAX_REDIRECTS=3
X1_RESEARCH_MAX_CONCURRENT_OPERATIONS=2
X1_RESEARCH_MAX_QUEUE_SIZE=12
X1_RESEARCH_QUEUE_TIMEOUT_SECONDS=12
X1_SEARCH_PROVIDER=searxng
X1_SEARCH_PROVIDERS=searxng
X1_SEARXNG_BASE_URL=http://searxng:8080
X1_BRAVE_SEARCH_API_KEY=
X1_SEARCH_TIMEOUT_SECONDS=8
X1_SEARCH_CACHE_TTL_SECONDS=3600
X1_RESEARCH_MAX_SEARCH_QUERIES=4
X1_RESEARCH_MAX_DISCOVERY_RESULTS=20

X1_CODE_WORKSPACE_STORAGE_PATH=./data/code_workspaces
X1_CODE_WORKSPACE_MAX_ARCHIVE_BYTES=15728640
X1_CODE_WORKSPACE_MAX_UNPACKED_BYTES=62914560
X1_CODE_WORKSPACE_MAX_FILES=3000
X1_CODE_ALLOW_UNSAFE_COMMANDS=false

# Code generation stays available. Local execution/preview is disabled on 6 GB
# so a sandbox cannot evict the LLM. Switch to remote after a server upgrade.
X1_PROJECT_RUNTIME_STORAGE_PATH=./data/project_runtimes
X1_PROJECT_RUNTIME_SECRET_KEY=change-me-runtime-secret
X1_PROJECT_RUNTIME_DEFAULT_CPU_LIMIT=0.75
X1_PROJECT_RUNTIME_DEFAULT_MEMORY_MB=512
X1_PROJECT_RUNTIME_DEFAULT_DISK_MB=1024
X1_PROJECT_RUNTIME_DEFAULT_PROCESS_LIMIT=48
X1_PROJECT_RUNTIME_MAX_CPU_LIMIT=1.0
X1_PROJECT_RUNTIME_MAX_MEMORY_MB=768
X1_PROJECT_RUNTIME_MAX_PROCESS_LIMIT=96
X1_PROJECT_SANDBOX_BACKEND=disabled
X1_PROJECT_SANDBOX_IMAGE=x1-sandbox:0.39
X1_PROJECT_SANDBOX_WORKER_URL=http://sandbox-worker:8090
X1_PROJECT_SANDBOX_WORKER_TOKEN=change-me-sandbox-worker
X1_PROJECT_SANDBOX_COMMAND_TIMEOUT_SECONDS=180
X1_PROJECT_SANDBOX_PREVIEW_TIMEOUT_SECONDS=90
X1_SANDBOX_MAX_CONCURRENT_EXECUTIONS=1
X1_SANDBOX_MAX_ACTIVE_PREVIEWS=1
X1_SANDBOX_MAX_MEMORY_MB=768
X1_SANDBOX_MAX_CPU=0.75
X1_SANDBOX_MAX_PIDS=96
X1_SANDBOX_PREVIEW_TTL_SECONDS=600

# Images are intentionally off on CPU-only 6 GB starter nodes.
X1_IMAGE_STORAGE_PATH=./data/images
X1_IMAGE_BACKEND=disabled
X1_IMAGE_MODEL_NAME=
X1_IMAGE_MODEL_PATH=
X1_IMAGE_EDIT_BACKEND=disabled
X1_IMAGE_EDIT_MODEL_NAME=
X1_IMAGE_EDIT_MODEL_PATH=
X1_IMAGE_EDIT_IDENTITY_MODEL_NAME=
X1_IMAGE_EDIT_IDENTITY_MODEL_PATH=
X1_IMAGE_EDIT_REQUIRE_VISION_QA=true
X1_IMAGE_VISION_QA_URL=
X1_IMAGE_USER_STORAGE_QUOTA_BYTES=268435456
X1_IMAGE_STORAGE_MIN_FREE_BYTES=10737418240
X1_IMAGE_STORAGE_MIN_FREE_PERCENT=15

# Commercial plans. Request units are user-facing limits; measured CPU seconds
# and resource budgets remain a second hard stop for unusually expensive work.
X1_MONTHLY_SERVER_COST_RUB=4000
X1_BILLING_CURRENCY=RUB
X1_BILLING_PERIOD_DAYS=30
X1_BILLING_CHECKOUT_TTL_MINUTES=30
X1_BILLING_PRICE_X1_MINOR=30000
X1_BILLING_PRICE_PRO_MINOR=70000
X1_BILLING_PRICE_MAX_MINOR=150000
X1_BILLING_PRICE_BUSINESS_MINOR=400000
X1_BILLING_CHECKOUT_URL_TEMPLATE=
X1_PAYMENT_INGEST_SECRET=
X1_PLAN_MONTHLY_REQUEST_UNITS_FREE=30
X1_PLAN_MONTHLY_REQUEST_UNITS_X1=240
X1_PLAN_MONTHLY_REQUEST_UNITS_PRO=720
X1_PLAN_MONTHLY_REQUEST_UNITS_MAX=1800
X1_PLAN_MONTHLY_REQUEST_UNITS_BUSINESS=4800
X1_PLAN_DAILY_REQUEST_UNITS_FREE=6
X1_PLAN_DAILY_REQUEST_UNITS_X1=24
X1_PLAN_DAILY_REQUEST_UNITS_PRO=60
X1_PLAN_DAILY_REQUEST_UNITS_MAX=120
X1_PLAN_DAILY_REQUEST_UNITS_BUSINESS=300
X1_REQUEST_UNIT_WEIGHT_FAST=1
X1_REQUEST_UNIT_WEIGHT_WORK=2
X1_REQUEST_UNIT_WEIGHT_DEEP=4

X1_COMMERCE_CPU_MICROUNITS_PER_SECOND=1000
X1_COMMERCE_GPU_MICROUNITS_PER_SECOND=10000
X1_COMMERCE_IMAGE_WORKER_MICROUNITS_PER_SECOND=5000
X1_COMMERCE_SANDBOX_MICROUNITS_PER_SECOND=2000
X1_API_DEFAULT_RATE_LIMIT_PER_MINUTE=30
X1_API_MAX_RATE_LIMIT_PER_MINUTE=120
X1_API_MAX_ACTIVE_KEYS_PER_USER=10
X1_API_MAX_CONTEXTS_PER_OWNER=50

X1_CHAT_HISTORY_MESSAGES=20
X1_CHAT_MESSAGE_PAGE_SIZE=100
X1_BACKUP_STORAGE_PATH=./backups
X1_HEALTH_CHECKPOINT_STALE_SECONDS=300
X1_HEALTH_BACKUP_MAX_AGE_HOURS=36
X1_RELEASE_GATE_REPORT_PATH=./backups/release-gate-latest.json
X1_RESTORE_DRILL_REPORT_PATH=./backups/restore-drill-latest.json
X1_RELEASE_GATE_MAX_AGE_HOURS=24
X1_RESTORE_DRILL_MAX_AGE_HOURS=168
X1_MAINTENANCE_ENABLED=true
X1_MAINTENANCE_INTERVAL_SECONDS=3600

X1_PUBLIC_LAUNCH_ENFORCE_EXPOSURE=true
X1_PUBLIC_LAUNCH_WATCHDOG_ENABLED=true
X1_PUBLIC_LAUNCH_WATCHDOG_INTERVAL_SECONDS=300
X1_PUBLIC_LAUNCH_AUTO_ROLLBACK=true
X1_PUBLIC_LAUNCH_BREAKER_MIN_REQUESTS=30
X1_PUBLIC_LAUNCH_CANARY_MIN_REQUESTS=20
X1_PUBLIC_LAUNCH_MAX_FAILURE_RATE=0.05
X1_PUBLIC_LAUNCH_MAX_REQUESTS_PER_USER_HOUR=30
X1_PUBLIC_LAUNCH_GLOBAL_BUDGET_MICROUNITS=0

# Fair scheduler shares. The image share is zero because image compute is off.
X1_PLAN_RATIO_FREE=0.25
X1_PLAN_RATIO_X1=1.0
X1_PLAN_RATIO_PRO=2.0
X1_PLAN_RATIO_MAX=4.0
X1_PLAN_RATIO_BUSINESS=8.0
X1_PLAN_SHARE_FAST=0.30
X1_PLAN_SHARE_WORK=0.40
X1_PLAN_SHARE_DEEP=0.15
X1_PLAN_SHARE_API=0.10
X1_PLAN_SHARE_IMAGE=0.00
X1_PLAN_SHARE_SANDBOX=0.05
