FROM python:3.12-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates git nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
       fastapi==0.141.1 uvicorn==0.52.4 sqlalchemy==2.0.52 \
       jinja2==3.1.6 python-multipart==0.0.32 httpx==0.28.1 \
       'pytest>=8.3,<10'

RUN groupadd --gid 10001 x1 \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/x1 x1 \
    && mkdir -p /workspace /x1-runtime \
    && chown -R x1:x1 /workspace /x1-runtime /home/x1

USER 10001:10001
WORKDIR /workspace
CMD ["python", "-V"]
