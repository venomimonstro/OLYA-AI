FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       chromium \
       ca-certificates \
       fonts-liberation \
       fonts-dejavu-core \
       libnss3 \
       libgbm1 \
       libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Pin the known upstream release used by this integration. The parser itself is
# LGPL-3.0-or-later; it runs only as an isolated import worker.
RUN pip install --no-cache-dir "parser-2gis==1.2.1"

WORKDIR /data

ENTRYPOINT ["parser-2gis"]
